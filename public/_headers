# Cache/security headers for hosts that read a _headers file (Netlify,
# Cloudflare Pages). GitHub Pages ignores this file; see docs/DEPLOYMENT.md.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
